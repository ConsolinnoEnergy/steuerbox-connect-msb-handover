{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/wellknown.schema.json",
  "title": "steuerbox-connect well-known document",
  "type": "object",
  "required": ["iana_pen", "client_ca", "contact"],
  "properties": {
    "iana_pen": {
      "type": "string",
      "description": "IANA PEN of the EMS manufacturer, e.g. 12345. The MSB MUST reject provisioning whose pairing_dataset.ship_id carries a different IANA PEN (fleet binding, ADR-0018).",
      "pattern": "^[0-9]{1,7}$"
    },
    "client_ca": {
      "type": "object",
      "required": ["pem", "scope"],
      "properties": {
        "pem": { "type": "string", "contentEncoding": "base64" },
        "scope": { "const": "steuerbox-connect-api" },
        "not_before": { "type": "string", "format": "date-time" },
        "not_after": { "type": "string", "format": "date-time" }
      }
    },
    "contact": { "type": "string" }
  }
}